[
  {
    "id": "masssave_insulation_condo_all_units",
    "version": "1",
    "programId": "masssave_weatherization",
    "title": "Up to 100% off insulation when every eligible condo unit takes part",
    "measure": "weatherization",
    "appliesTo": "each_unit",
    "dateBasis": "as_of",
    "effective": {
      "from": "2025-01-01",
      "until": null
    },
    "applicationDeadline": null,
    "eligibility": {
      "all": [
        {
          "fact": "building.ownership",
          "op": "eq",
          "value": "condo"
        },
        {
          "fact": "building.unitCount",
          "op": "gte",
          "value": 2
        },
        {
          "fact": "unit.hasResidentialHeatingMeter",
          "op": "eq",
          "value": true
        },
        {
          "any": [
            {
              "fact": "building.electricIsMunicipal",
              "op": "eq",
              "value": false
            },
            {
              "fact": "building.gasUtility",
              "op": "in",
              "value": [
                "eversource",
                "national_grid",
                "unitil",
                "liberty",
                "berkshire_gas"
              ]
            }
          ]
        }
      ]
    },
    "prerequisites": [
      {
        "id": "all_eligible_units_agree",
        "kind": "coordination",
        "description": "Every eligible unit in the building takes part.",
        "satisfiedWhen": {
          "allUnits": {
            "eligible": {
              "ref": "condo_eligible_unit"
            },
            "require": {
              "fact": "unit.participating",
              "op": "eq",
              "value": true
            }
          }
        },
        "sources": [
          {
            "url": "https://www.masssave.com/saving/energy-assessments/landlords-with-1-4-unit-properties",
            "section": "Condo Owners",
            "quote": "if all eligible units in a 2–4-unit building participate (or up to 75% off per unit if only some participate)",
            "lastVerified": "2026-11-06"
          }
        ]
      }
    ],
    "confirmations": [
      {
        "id": "condo_eligible_definition",
        "question": "Which units count as 'eligible' for the all-units rule? We assume units with a residential heating meter, so the number of units still needed depends on this answer.",
        "decidedBy": "Mass Save",
        "nextAction": "Ask the Energy Specialist, or call Mass Save at 866-527-7283.",
        "when": null,
        "sources": [
          {
            "url": "https://www.masssave.com/saving/energy-assessments/landlords-with-1-4-unit-properties",
            "section": "Condo Owners",
            "quote": "if all eligible units in a 2–4-unit building participate",
            "lastVerified": "2026-11-06"
          }
        ]
      }
    ],
    "benefit": {
      "type": "percent_of_cost",
      "pct": 100,
      "costOf": "weatherization"
    },
    "qualification": "up_to",
    "recipient": "property_owner",
    "enrollment": "via_assessment",
    "exclusiveGroup": "insulation",
    "capGroups": [],
    "sources": [
      {
        "url": "https://www.masssave.com/saving/energy-assessments/landlords-with-1-4-unit-properties",
        "section": "Condo Owners",
        "quote": "Up to 100% off recommended insulation improvements for each unit, if all eligible units in a 2–4-unit building participate (or up to 75% off per unit if only some participate) *",
        "lastVerified": "2026-11-06"
      },
      {
        "url": "https://www.masssave.com/saving/energy-assessments/landlords-with-1-4-unit-properties",
        "section": "Condo Owners footnote",
        "quote": "*Unit must have a residential heating meter",
        "lastVerified": "2026-11-06"
      }
    ]
  },
