[
  {
    "id": "ashp_whole_home",
    "version": "2026",
    "programId": "masssave_heat_pumps",
    "title": "Whole-home heat pump rebate (installed in 2026)",
    "measure": "heat_pump",
    "appliesTo": "each_unit",
    "dateBasis": "installation",
    "effective": {
      "from": "2026-01-01",
      "until": "2026-12-31"
    },
    "applicationDeadline": "2027-02-28",
    "eligibility": {
      "all": [
        {
          "fact": "unit.occupiedAllWinter",
          "op": "eq",
          "value": true
        },
        {
          "any": [
            {
              "all": [
                {
                  "fact": "unit.heatingFuel",
                  "op": "in",
                  "value": [
                    "oil",
                    "propane",
                    "electric_resistance"
                  ]
                },
                {
                  "fact": "building.electricIsMunicipal",
                  "op": "eq",
                  "value": false
                }
              ]
            },
            {
              "all": [
                {
                  "fact": "unit.heatingFuel",
                  "op": "eq",
                  "value": "natural_gas"
                },
                {
                  "fact": "building.gasUtility",
                  "op": "in",
                  "value": [
                    "eversource",
                    "national_grid",
                    "unitil",
                    "liberty",
                    "berkshire_gas"
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "prerequisites": [
      {
        "id": "weatherized",
        "kind": "action",
        "description": "Make sure the home is sufficiently weatherized: built 2000 or later, or the assessment recommends under $1,000 of weatherization, or the recommended weatherization is done.",
        "satisfiedWhen": {
          "any": [
            {
              "fact": "building.yearBuilt",
              "op": "gte",
              "value": 2000
            },
            {
              "fact": "building.weatherizationRecsDone",
              "op": "eq",
              "value": true
            }
          ]
        },
        "sources": [
          {
            "url": "https://www.masssave.com/en/residential/rebates-offers-services/heating-and-cooling/heat-pumps/air-source-heat-pumps",
            "section": "Additional eligibility requirements for the Whole-home Rebate",
            "quote": "Sufficient weatherization can be demonstrated by satisfying at least one of the following requirements: (A) home was built during or after 2000, (B) Home Energy Assessment report indicates less than $1,000 worth of weatherization recommended, or (C) weatherization recommendations made during or after 2013 have been completed.",
            "lastVerified": "2026-11-06"
          }
        ]
      },
      {
        "id": "owner_approval",
        "kind": "action",
        "description": "For rented units, the landlord approves the work.",
        "satisfiedWhen": {
          "any": [
            {
              "fact": "unit.occupancy",
              "op": "eq",
              "value": "owner"
            },
            {
              "fact": "building.ownerApproval",
              "op": "eq",
              "value": true
            }
          ]
        },
        "sources": [
          {
            "url": "https://www.masssave.com/en/residential/for-renters",
            "section": "Resources for renters",
            "quote": "While larger measures like weatherization and heating and cooling system upgrades require property owner approval, there are actions you can take on your own.",
            "lastVerified": "2026-11-06"
          }
        ]
      },
      {
        "id": "sole_source",
        "kind": "requirement",
        "description": "The heat pump must be the home's only heating and cooling source.",
        "satisfiedWhen": null,
        "sources": [
          {
            "url": "https://www.masssave.com/en/residential/rebates-offers-services/heating-and-cooling/heat-pumps/air-source-heat-pumps",
            "section": "Rebates",
            "quote": "Whole-home rebates are available to customers who install heat pumps as the sole source for heating and cooling.",
            "lastVerified": "2026-11-06"
          }
        ]
      },
      {
        "id": "network_installer",
        "kind": "requirement",
        "description": "Use a contractor in the Mass Save Heat Pump Installer Network.",
        "satisfiedWhen": null,
        "sources": [
          {
            "url": "https://www.masssave.com/en/residential/rebates-offers-services/heating-and-cooling/heat-pumps/air-source-heat-pumps",
            "section": "How to Participate",
            "quote": "To qualify, the heat pump system must be installed by a contractor participating in the Mass Save Heat Pump Installer Network.",
            "lastVerified": "2026-11-06"
          }
        ]
      },
      {
        "id": "cold_climate_equipment",
        "kind": "requirement",
        "description": "Choose ENERGY STAR Cold Climate equipment from the Mass Save qualified list.",
        "satisfiedWhen": null,
        "sources": [
          {
            "url": "https://www.masssave.com/en/residential/rebates-offers-services/heating-and-cooling/heat-pumps/air-source-heat-pumps",
            "section": "Eligibility",
            "quote": "Equipment must meet ENERGY STAR® Cold Climate.",
            "lastVerified": "2026-11-06"
          }
        ]
      }
    ],
    "confirmations": [
      {
        "id": "tenant_account_holder",
        "question": "The rebate is applied for with a residential electric account (replacing oil, propane or electric resistance) or a residential gas account (replacing gas). In a rental unit where the tenant holds that account and the landlord buys the heat pump, who applies?",
        "decidedBy": "Mass Save rebate processing (Resource Innovations)",
        "nextAction": "Ask at the assessment, or email MARebates@Resource-Innovations.com.",
        "when": {
          "fact": "unit.occupancy",
          "op": "eq",
          "value": "renter"
        },
        "sources": [
          {
            "url": "https://www.masssave.com/en/residential/rebates-offers-services/heating-and-cooling/heat-pumps/air-source-heat-pumps",
            "section": "Eligibility",
            "quote": "Customers must apply using a residential electric account.",
            "lastVerified": "2026-11-06"
          },
          {
            "url": "https://www.masssave.com/en/residential/rebates-offers-services/heating-and-cooling/heat-pumps/air-source-heat-pumps",
            "section": "Eligibility",
            "quote": "Customers must apply using a residential gas account.",
            "lastVerified": "2026-11-06"
          }
        ]
      }
    ],
    "benefit": {
      "type": "per_ton",
      "rate": 2650,
      "cap": 8500
    },
    "qualification": "up_to",
    "recipient": "property_owner",
    "enrollment": "apply",
    "exclusiveGroup": "heat_pump",
    "capGroups": [
      "masssave_hp_account",
      "masssave_whole_home"
    ],
    "sources": [
      {
        "url": "https://www.masssave.com/en/residential/rebates-offers-services/heating-and-cooling/heat-pumps/air-source-heat-pumps",
        "section": "2026 Air Source Heat Pump Rebates",
        "quote": "Whole-Home $2,650 per ton * up to $8,500",
        "lastVerified": "2026-11-06"
      },
      {
        "url": "https://www.masssave.com/en/residential/rebates-offers-services/heating-and-cooling/heat-pumps/air-source-heat-pumps",
        "section": "Eligibility",
        "quote": "Rebate form and supporting documentation must be received by February 28, 2027.",
        "lastVerified": "2026-11-06"
      },
      {
        "url": "https://www.masssave.com/en/residential/rebates-offers-services/heating-and-cooling/heat-pumps/air-source-heat-pumps",
        "section": "Additional eligibility requirements for the Whole-home Rebate",
        "quote": "Only available to residences that are occupied full time during the winter heating season.",
        "lastVerified": "2026-11-06"
      }
    ]
  },
